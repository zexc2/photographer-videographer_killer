#!/usr/bin/env bash
# Fake SSH: prints the contents of $FAKE_DIR/util as the nvidia-smi result; if the file says FAIL, simulates SSH being unreachable.
# If the remote command contains ATLAS_RUNS_QUERY, returns $FAKE_DIR/runs_status (status of atlas-run registered runs: run status seconds-since-finish)
v=$(cat "$FAKE_DIR/util" 2>/dev/null || echo 0)
[ "$v" = FAIL ] && exit 255
case "${*: -1}" in
  *ATLAS_RUNS_QUERY*) cat "$FAKE_DIR/runs_status" 2>/dev/null; exit 0 ;;
esac
echo "$v"
[ -f "$FAKE_DIR/busy" ] && echo "BUSY_AGE=$(cat "$FAKE_DIR/busy")"
exit 0
